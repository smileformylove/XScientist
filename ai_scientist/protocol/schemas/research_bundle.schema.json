{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-git.v1/research_bundle.schema.json",
  "title": "XScientist Offline Research Bundle",
  "description": "A portable Git bundle plus the selected local CAS closure.",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_kind",
    "created_at",
    "profile",
    "repository_head",
    "repository_branch",
    "complete",
    "missing_objects",
    "entries",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "xscientist.research-bundle.v1"},
    "protocol_kind": {"type": "string", "const": "research_bundle"},
    "created_at": {"type": "string"},
    "profile": {"type": "string", "enum": ["index", "reproduce", "audit"]},
    "repository_head": {"type": "string"},
    "repository_branch": {"type": "string"},
    "closure": {
      "type": "object",
      "required": [
        "version",
        "scope",
        "refs",
        "reachable_commits",
        "pointers",
        "required_objects"
      ],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "scope": {"type": "string", "const": "all-advertised-refs"},
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "object"],
            "properties": {
              "name": {"type": "string"},
              "object": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
            },
            "additionalProperties": false
          }
        },
        "reachable_commits": {
          "type": "object",
          "required": ["count", "content_hash"],
          "properties": {
            "count": {"type": "integer", "minimum": 1},
            "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "pointers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "git_blob",
              "member",
              "blob_hash",
              "pointer_hash",
              "object_hash",
              "size"
            ],
            "properties": {
              "path": {"type": "string"},
              "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
              "member": {"type": "string"},
              "blob_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "pointer_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "size": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "required_objects": {
          "type": "array",
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "complete": {"type": "boolean"},
    "missing_objects": {"type": "array", "items": {"type": "string"}},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash", "size"],
        "properties": {
          "path": {"type": "string"},
          "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
