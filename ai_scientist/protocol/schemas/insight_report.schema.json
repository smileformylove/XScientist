{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/insight-report.v1/insight_report.schema.json",
  "title": "XScientist Evidence-Bound Insight Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "epistemic_status",
    "independent_verification",
    "synthesis_mode",
    "evidence_pack_hash",
    "evidence_selectors",
    "insights",
    "global_limitations",
    "warnings",
    "report_hash"
  ],
  "properties": {
    "schema_version": {"const": "xscientist.insight-report.v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "epistemic_status": {"const": "machine_synthesized_unverified"},
    "independent_verification": {"const": false},
    "synthesis_mode": {"enum": ["deterministic", "llm_evidence_bound", "deterministic_fallback"]},
    "evidence_pack_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_selectors": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["idea_idx", "title", "claim", "kind", "confidence", "epistemic_status", "evidence_refs", "rival_hypotheses", "why_it_matters", "uncertainty", "next_experiment"],
        "properties": {
          "idea_idx": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "kind": {"enum": ["mechanism", "boundary", "negative", "comparative", "methodological"]},
          "confidence": {"enum": ["low", "medium"]},
          "epistemic_status": {"const": "machine_synthesized_unverified"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "rival_hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "why_it_matters": {"type": "string", "minLength": 1},
          "uncertainty": {"type": "string", "minLength": 1},
          "next_experiment": {
            "type": "object",
            "required": ["question", "design", "expected_information_gain"],
            "properties": {
              "question": {"type": "string", "minLength": 1},
              "design": {"type": "string", "minLength": 1},
              "expected_information_gain": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "global_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "report_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
