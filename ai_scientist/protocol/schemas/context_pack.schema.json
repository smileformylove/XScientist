{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/ara.v1/context_pack.schema.json",
  "title": "ARA ContextPack",
  "description": "A bounded task-specific view compiled from the complete stored record.",
  "type": "object",
  "required": ["schema_version", "protocol_kind", "intent", "target", "must_read", "source_refs", "source_closure_hash", "memory_refs", "memory_snapshot_hash", "pack_hash", "complete"],
  "properties": {
    "schema_version": {"type": "string"},
    "protocol_kind": {"type": "string", "const": "context_pack"},
    "intent": {"type": "string", "enum": ["continue", "write", "audit", "reproduce", "decide"]},
    "target": {"type": "object"},
    "consumer": {"type": "string"},
    "generated_at": {"type": "string"},
    "must_read": {"type": "array"},
    "decisive_evidence": {"type": "array"},
    "failed_attempts": {"type": "array"},
    "do_not_repeat": {"type": "array"},
    "open_questions": {"type": "array"},
    "constraints": {"type": "array"},
    "related_claims": {"type": "array"},
    "decision": {"type": "object"},
    "execution": {"type": "object"},
    "verification_rules": {"type": "array"},
    "verification_reports": {"type": "array"},
    "source_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "source_closure_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "memory_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "memory_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pack_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "persisted_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Optional non-identity CAS location added after persistence; excluded from pack_hash to avoid self-reference."
    },
    "complete": {"type": "boolean"},
    "blockers": {"type": "array"},
    "omitted": {"type": "object"},
    "retrieval_receipt": {
      "type": "object",
      "required": ["profile", "request", "request_hash", "algorithm", "algorithm_hash", "candidate_set", "candidate_set_hash", "complete_candidate_set", "receipt_hash"],
      "properties": {
        "profile": {"type": "string"},
        "request": {"type": "object"},
        "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "algorithm": {"type": "object"},
        "algorithm_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidate_set": {"type": "array"},
        "candidate_set_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "complete_candidate_set": {"type": "boolean"},
        "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "working_memory": {
      "type": "object",
      "required": ["policy_version", "required_semantic_lanes", "visible_semantic_lanes", "missing_semantic_lanes", "source_count", "memory_count", "working_memory_hash"],
      "properties": {
        "policy_version": {"type": "string"},
        "required_semantic_lanes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "visible_semantic_lanes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "missing_semantic_lanes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_count": {"type": "integer", "minimum": 0},
        "memory_count": {"type": "integer", "minimum": 0},
        "working_memory_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "requested_tokens": {"type": "integer", "minimum": 1},
        "prompt_estimated_tokens": {"type": "integer", "minimum": 0},
        "audit_source_count": {"type": "integer", "minimum": 0},
        "hard_closure_preserved": {"type": "boolean"},
        "decision_usable": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
