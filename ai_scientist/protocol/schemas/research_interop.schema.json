{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-vcs.v1/research_interop.schema.json",
  "title": "XScientist Research Interoperability Export Manifest",
  "type": "object",
  "required": ["schema_version", "repository_commit", "checkpoint_id", "generated_at", "formats", "payloads_included", "object_count", "files", "export_hash"],
  "properties": {
    "schema_version": {"const": "xscientist.research-interop.v1"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ro-crate", "prov-json", "cwl", "dvc", "mlflow"]}},
    "payloads_included": {"type": "boolean"},
    "object_count": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "hash", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "export_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
