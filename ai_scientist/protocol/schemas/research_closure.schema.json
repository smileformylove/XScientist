{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-closure.v3/research_closure.schema.json",
  "title": "XScientist Scientific Closure Audit",
  "description": "A payload-free audit view linking claims to evidence, attempts, plans, preregistrations, gates, and reproductions.",
  "type": "object",
  "required": ["schema_version", "ref", "commit", "target_level", "status", "complete", "counts", "superseded_claim_ids", "claims", "blockers", "warnings", "closure_levels", "integrity", "trajectory", "payloads_disclosed", "content_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "xscientist.research-closure.v3"},
    "ref": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "target_level": {"type": "string", "enum": ["trace", "replay", "verify"]},
    "status": {"type": "string", "enum": ["complete", "blocked"]},
    "complete": {"type": "boolean"},
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "state", "evidence_ids", "experimental_evidence_ids", "passage_evidence_ids", "source_snapshot_ids", "search_receipt_ids", "search_plan_ids", "argument_ids", "source_update_ids", "attempt_ids", "claim_attempt_ids", "study_evidence_ids", "attempt_states", "plan_ids", "preregistration_ids", "priority_ids", "gate_ids", "reproduction_ids", "reproduction_closure_ids", "trace_complete", "replay_ready", "verified", "complete", "missing"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^rso-[0-9a-f]{16}$"},
          "state": {"type": "string"},
          "evidence_ids": {"$ref": "#/$defs/objectIds"},
          "experimental_evidence_ids": {"$ref": "#/$defs/objectIds"},
          "passage_evidence_ids": {"$ref": "#/$defs/objectIds"},
          "source_snapshot_ids": {"$ref": "#/$defs/objectIds"},
          "search_receipt_ids": {"$ref": "#/$defs/objectIds"},
          "search_plan_ids": {"$ref": "#/$defs/objectIds"},
          "argument_ids": {"$ref": "#/$defs/objectIds"},
          "source_update_ids": {"$ref": "#/$defs/objectIds"},
          "attempt_ids": {"$ref": "#/$defs/objectIds"},
          "claim_attempt_ids": {"$ref": "#/$defs/objectIds"},
          "study_evidence_ids": {"$ref": "#/$defs/objectIds"},
          "attempt_states": {
            "type": "object",
            "patternProperties": {
              "^rso-[0-9a-f]{16}$": {
                "type": "string",
                "enum": ["draft", "locked", "running", "completed", "failed", "timed_out", "cancelled", "rejected", "superseded", "verified", "promoted"]
              }
            },
            "additionalProperties": false
          },
          "plan_ids": {"$ref": "#/$defs/objectIds"},
          "preregistration_ids": {"$ref": "#/$defs/objectIds"},
          "priority_ids": {"$ref": "#/$defs/objectIds"},
          "gate_ids": {"$ref": "#/$defs/objectIds"},
          "reproduction_ids": {"$ref": "#/$defs/objectIds"},
          "reproduction_closure_ids": {"$ref": "#/$defs/objectIds"},
          "trace_complete": {"type": "boolean"},
          "replay_ready": {"type": "boolean"},
          "verified": {"type": "boolean"},
          "complete": {"type": "boolean"},
          "missing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "superseded_claim_ids": {"$ref": "#/$defs/objectIds"},
    "blockers": {"$ref": "#/$defs/issues"},
    "warnings": {"$ref": "#/$defs/issues"},
    "closure_levels": {
      "type": "object",
      "description": "One-shot trace/replay/verify readiness summary; issue payloads remain in the selected level's blockers/warnings arrays.",
      "required": ["trace", "replay", "verify"],
      "properties": {
        "trace": {"$ref": "#/$defs/closureLevel"},
        "replay": {"$ref": "#/$defs/closureLevel"},
        "verify": {"$ref": "#/$defs/closureLevel"}
      },
      "additionalProperties": false
    },
    "integrity": {"type": "object"},
    "trajectory": {"$ref": "#/$defs/trajectory"},
    "payloads_disclosed": {"type": "boolean", "const": false},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "objectIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^rso-[0-9a-f]{16}$"},
      "uniqueItems": true
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "object_id", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "object_id": {"type": "string"},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "closureLevel": {
      "type": "object",
      "required": [
        "complete",
        "status",
        "claim_count",
        "complete_claim_count",
        "blocker_count",
        "warning_count",
        "blocker_codes",
        "warning_codes"
      ],
      "properties": {
        "complete": {"type": "boolean"},
        "status": {"type": "string", "enum": ["complete", "blocked"]},
        "claim_count": {"type": "integer", "minimum": 0},
        "complete_claim_count": {"type": "integer", "minimum": 0},
        "blocker_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "blocker_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "warning_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "schema_version", "projection_hash", "resolved_head", "complete", "truncated", "checkpoint_count", "boundary_parent_edges", "boundary_rollback_edges", "errors"],
      "properties": {
        "ok": {"type": "boolean"},
        "schema_version": {
          "anyOf": [
            {"const": "xscientist.structured-trajectory-projection.v1"},
            {"type": "null"}
          ]
        },
        "projection_hash": {
          "anyOf": [
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "resolved_head": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
            {"type": "null"}
          ]
        },
        "complete": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "checkpoint_count": {"type": "integer", "minimum": 0, "maximum": 127},
        "boundary_parent_edges": {
          "type": "array",
          "maxItems": 127,
          "items": {"$ref": "#/$defs/parentBoundary"}
        },
        "boundary_rollback_edges": {
          "type": "array",
          "maxItems": 127,
          "items": {"$ref": "#/$defs/rollbackBoundary"}
        },
        "errors": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 8192}
        }
      }
    },
    "parentBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_commit", "parent_commit", "parent_checkpoint_hash"],
      "properties": {
        "child_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "parent_checkpoint_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "rollbackBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revert_commit", "revert_checkpoint_hash", "target_commit", "target_checkpoint_hash"],
      "properties": {
        "revert_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "revert_checkpoint_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "target_checkpoint_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": false
}
