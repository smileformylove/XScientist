{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-vcs.v1/research_adapter_receipt.schema.json",
  "title": "XScientist Research Platform Adapter Receipt",
  "type": "object",
  "required": ["schema_version", "published_at", "adapter", "ref", "export_manifest_hash", "include_payloads", "result", "receipt_hash"],
  "properties": {
    "schema_version": {"const": "xscientist.research-adapter-receipt.v1"},
    "published_at": {"type": "string"},
    "adapter": {
      "type": "object",
      "required": ["name", "api_version", "version", "description", "capabilities", "destination_kinds", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "api_version": {"const": "1.0"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "destination_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ref": {"type": "string", "minLength": 1},
    "export_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "include_payloads": {"type": "boolean"},
    "result": {"type": "object"},
    "receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
