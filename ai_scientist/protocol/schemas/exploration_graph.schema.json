{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/ara.v1/exploration_graph.schema.json",
  "title": "ARA Exploration Graph",
  "description": "The full tree-search graph — nodes + edges + counts. Failed branches MUST be present, not filtered out.",
  "type": "object",
  "required": ["schema_version", "nodes", "edges", "counts"],
  "properties": {
    "schema_version": {"type": "string"},
    "protocol_kind": {"type": "string", "const": "exploration_graph"},
    "topology_encoding": {
      "type": "string",
      "enum": ["edges", "redundant"],
      "description": "New producers use edges as the sole canonical topology; redundant denotes legacy parent_id/children mirrors."
    },
    "generated_at": {"type": "string"},
    "source_journals": {"type": "array", "items": {"type": "string"}},
    "authority_attempts": {
      "type": ["object", "null"],
      "description": "Immutable, content-addressed audit of all authority attempts, including terminal attempts that produced no Node.",
      "required": ["schema", "path", "bundle_root", "content_hash", "object"],
      "properties": {
        "schema": {"type": "string", "const": "xscientist.ara.authority-attempts.v1"},
        "path": {"type": "string", "const": "authority_attempts.json"},
        "bundle_root": {"type": "string", "const": "authority/ledgers"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "object": {
          "type": "object",
          "required": ["hash", "size", "gzip"],
          "properties": {
            "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "size": {"type": "integer", "minimum": 0},
            "gzip": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "content_hash": {
            "type": ["string", "null"],
            "description": "sha256:<hex>. See content_hash_inputs for which fields fed the hash."
          },
          "identity_profile": {
            "type": "string",
            "enum": ["ara.node-identity.v1", "ara.node-identity.v2"],
            "description": "Canonical identity recipe. Missing means the legacy v1 recipe."
          },
          "execution_identity": {
            "type": "object",
            "description": "Portable data, environment, runner, tool, seed, and observed-dependency identities bound into the node hash."
          },
          "content_hash_inputs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Which categories of input contributed to content_hash. Older ARAs omit this and are treated as ['code','metric']. Add 'evaluation' for a verified deterministic evaluation and 'llm_calls' when llm_call_hashes were bound in."
          },
          "llm_call_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "description": "Semantic call_receipt_ref.hash values from llm/calls.jsonl that produced this node; legacy graphs may contain messages_ref hashes."
          },
          "context_pack_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "description": "ContextPack object hashes injected immediately before this node was planned."
          },
          "selection_llm_call_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "description": "Semantic call receipts for judgment-model decisions that selected this node."
          },
          "authority_attempt_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^attempt-[0-9a-f]{32}$"},
            "uniqueItems": true,
            "description": "Ordered append-only authority attempts that affected this node."
          },
          "authority_attempt_terminal_hashes": {
            "type": "object",
            "propertyNames": {"pattern": "^attempt-[0-9a-f]{32}$"},
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "description": "Terminal event hashes for every authority_attempt_id; both fields are bound into content_hash."
          },
          "implementation_spec_hash": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Canonical judgment-locked experiment specification bound into content_hash."
          },
          "repair_spec_hash": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Canonical technical repair specification bound into content_hash when present."
          },
          "parse_metrics_spec_hash": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Canonical metric-parser implementation specification bound into content_hash."
          },
          "plot_spec_hash": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Canonical plotting implementation specification bound into content_hash."
          },
          "stage": {"type": ["string", "null"]},
          "step": {"type": ["integer", "null"]},
          "parent_id": {"type": ["string", "null"]},
          "children": {"type": "array", "items": {"type": "string"}},
          "is_buggy": {"type": ["boolean", "null"]},
          "is_seed_node": {"type": ["boolean", "null"]},
          "is_seed_agg_node": {"type": ["boolean", "null"]},
          "metric": {"type": ["object", "null"]},
          "metric_provenance": {
            "type": "string",
            "enum": ["deterministic_verified", "agent_reported", "unavailable"]
          },
          "evaluation_report": {"type": ["object", "null"]},
          "plan_excerpt": {"type": "string"},
          "exp_results_dir": {"type": ["string", "null"]},
          "ctime": {"type": ["number", "null"]},
          "artifacts_dir": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parent", "child"],
        "properties": {
          "parent": {"type": "string"},
          "child": {"type": "string"},
          "stage": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "counts": {
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0},
        "buggy": {"type": "integer", "minimum": 0},
        "authority_attempts": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
