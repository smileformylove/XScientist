{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/ara.v1/bundle_manifest.schema.json",
  "title": "ARA Bundle Manifest",
  "type": "object",
  "required": ["schema", "created_at", "profile", "included_paths", "complete"],
  "properties": {
    "schema": {"const": "ara.bundle.v1"},
    "created_at": {"type": "string"},
    "profile": {"enum": ["index", "fork", "reproduce", "audit"]},
    "source_manifest_hash": {"type": ["string", "null"]},
    "selected_nodes": {"type": "array", "items": {"type": "string"}},
    "selected_claims": {"type": "array", "items": {"type": "string"}},
    "included_paths": {"type": "array", "items": {"type": "string"}},
    "object_refs": {"type": "array", "items": {"type": "string"}},
    "missing_object_refs": {"type": "array", "items": {"type": "string"}},
    "complete": {"type": "boolean"}
  },
  "additionalProperties": true
}
