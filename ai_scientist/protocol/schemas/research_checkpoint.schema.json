{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-git.v1/research_checkpoint.schema.json",
  "title": "XScientist Local Research Checkpoint",
  "description": "A compact scientific state transition bound to one local Git commit.",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_kind",
    "checkpoint_id",
    "sequence",
    "created_at",
    "stage",
    "status",
    "subject",
    "actor",
    "changed_paths",
    "ara_manifests",
    "object_refs",
    "reproduce",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "xscientist.research-checkpoint.v1"},
    "protocol_kind": {"type": "string", "const": "research_checkpoint"},
    "checkpoint_id": {"type": "string", "pattern": "^rcp-[0-9a-f]{16}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "stage": {"type": "string"},
    "status": {"type": "string"},
    "subject": {"type": "string"},
    "summary": {"type": "string"},
    "actor": {"type": "string"},
    "branch": {"type": "string"},
    "parent_commit": {"type": ["string", "null"]},
    "previous_checkpoint_hash": {"type": ["string", "null"]},
    "parent_checkpoint_hashes": {
      "type": "array",
      "description": "Scientific parent checkpoint hashes. Merge convergence may have multiple parents; previous_checkpoint_hash remains the first-parent compatibility view.",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "nodes": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "items": {"type": "string"}},
    "ara_manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "manifest_hash"],
        "properties": {
          "path": {"type": "string"},
          "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "exploration_graph_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Canonical hash of the exploration_graph.json snapshot committed with this manifest. Optional for checkpoints created before graph binding was introduced."
          }
        }
      }
    },
    "object_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "reproduce": {
      "type": "object",
      "required": ["command", "working_directory"],
      "properties": {
        "command": {"type": "string"},
        "working_directory": {"type": "string"},
        "environment": {
          "type": "object",
          "description": "Content-addressed research_environment receipt. Optional for checkpoints created before environment receipts were introduced."
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
