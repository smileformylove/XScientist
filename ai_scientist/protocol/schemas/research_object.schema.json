{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-vcs.v1/research_object.schema.json",
  "title": "XScientist Research VCS Object",
  "description": "One immutable, content-addressed scientific or agent-evolution object.",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_kind",
    "object_id",
    "kind",
    "state",
    "payload",
    "relations",
    "actor",
    "provenance",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "xscientist.research-object.v1"
    },
    "protocol_kind": {
      "type": "string",
      "const": "research_object"
    },
    "object_id": {
      "type": "string",
      "pattern": "^rso-[0-9a-f]{16}$"
    },
    "qualified_id": {
      "type": "string",
      "pattern": "^urn:xscientist:research-object:sha256:[0-9a-f]{64}$"
    },
    "identity_profile": {
      "type": "string",
      "enum": [
        "xscientist.research-object-identity.v1",
        "xscientist.research-object-identity.v2"
      ]
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "semantic_profile": {
      "type": "object",
      "required": [
        "schema",
        "uri",
        "version",
        "kinds",
        "relations",
        "schema_digest"
      ],
      "properties": {
        "schema": {
          "const": "xscientist.research-semantic-profile.v1"
        },
        "uri": {
          "type": "string",
          "pattern": "^(https?://|urn:)"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "uniqueItems": true
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "locked",
        "running",
        "completed",
        "failed",
        "timed_out",
        "cancelled",
        "rejected",
        "superseded",
        "verified",
        "promoted"
      ]
    },
    "payload": {
      "type": "object"
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "actor": {
      "type": "object",
      "required": ["actor_id", "authority"],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "research_agent",
            "recorder",
            "independent_evaluator",
            "deterministic_gate",
            "human"
          ]
        },
        "agent_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "environment_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "code_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "code_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "ara_manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ara_exploration_graph_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "memory_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "decision_input_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evaluator_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dataset_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "dependency_lock_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uniqueItems": true
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "envelope_hash": {
      "type": "string",
      "description": "Hash binding host ordering metadata without changing semantic object identity. Optional only for pre-envelope objects.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["identity_profile"],
        "properties": {
          "identity_profile": {
            "const": "xscientist.research-object-identity.v2"
          }
        }
      },
      "then": {
        "required": ["envelope_hash"],
        "properties": {
          "created_at": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          }
        }
      }
    },
    {
      "if": {
        "required": ["identity_profile"],
        "properties": {
          "identity_profile": {
            "const": "xscientist.research-object-identity.v1"
          }
        }
      },
      "then": {
        "not": {
          "required": ["envelope_hash"]
        }
      }
    }
  ],
  "additionalProperties": false
}
