{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-vcs.v1/video_asset.schema.json",
  "title": "XScientist Video Asset",
  "type": "object",
  "required": ["protocol_kind", "title", "content_hash", "size_bytes", "media", "artifact_hashes", "source_hash"],
  "properties": {
    "protocol_kind": {"const": "xscientist.video-asset.v1"},
    "title": {"type": "string", "minLength": 1, "maxLength": 512},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 17179869184},
    "artifact_hashes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "media": {
      "type": "object",
      "required": ["duration_seconds", "time_origin", "stream_index", "width", "height", "codec", "time_base", "average_frame_rate", "container", "audio_stream_count", "probe_version"],
      "properties": {
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "time_origin": {"const": "first_decoded_video_frame"},
        "stream_index": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1, "maximum": 32768},
        "height": {"type": "integer", "minimum": 1, "maximum": 32768},
        "codec": {"type": "string", "minLength": 1, "maxLength": 128},
        "time_base": {"type": "string", "minLength": 1, "maxLength": 128},
        "average_frame_rate": {"type": "string", "minLength": 1, "maxLength": 128},
        "container": {"type": "string", "minLength": 1, "maxLength": 256},
        "audio_stream_count": {"type": "integer", "minimum": 0},
        "probe_version": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
