{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xscientist.io/protocol/research-vcs.v1/research_dag.schema.json",
  "title": "XScientist Unified Scientific Evidence DAG",
  "type": "object",
  "required": ["schema_version", "ref", "commit", "content_disclosed", "sources", "nodes", "edges", "proof_summary", "theory_frontier", "claim_insights", "strategy_summary", "scientific_closure", "integrity", "generated_at", "graph_hash"],
  "properties": {
    "schema_version": {"const": "xscientist.research-dag.v1"},
    "ref": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "content_disclosed": {"type": "boolean"},
    "sources": {"type": "array", "items": {"type": "object"}},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "kind", "state", "phase", "layer", "summary", "content_hash", "actor", "created_at", "proof", "source_ref"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"enum": ["research_vcs", "ara"]},
          "kind": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "phase": {"type": "integer", "minimum": 0},
          "layer": {"enum": ["strategy", "execution", "evidence", "theory", "decision_memory", "evolution"]},
          "summary": {"type": "string"},
          "content_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "actor": {"type": ["object", "null"]},
          "created_at": {"type": ["string", "null"]},
          "source_ref": {"type": "string"},
          "proof": {
            "type": "object",
            "required": ["level", "checks", "blockers", "warnings", "contested"],
            "properties": {
              "level": {"enum": ["recorded", "traceable", "replayable", "verified", "contested"]},
              "checks": {"type": "array", "items": {"type": "object", "required": ["code", "label", "passed", "layer"]}},
              "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "contested": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "role", "category"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "role": {"type": "string"},
          "category": {"enum": ["lineage", "unknown", "support", "challenge", "verification", "evolution", "context", "argument", "provenance", "decision", "theory", "boundary", "strategy"]}
        },
        "additionalProperties": false
      }
    },
    "proof_summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "theory_frontier": {
      "type": "object",
      "required": ["active_hypothesis_ids", "portfolio_ids", "prediction_ids", "posterior_ids", "mechanism_ids", "open_anomaly_ids", "open_questions", "portfolio_frontiers", "next_experiments", "next_experiment", "frontier_hash"],
      "properties": {
        "historical_hypothesis_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "description": "All recorded hypothesis objects, including contested, terminal, and superseded history."},
        "contested_hypothesis_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "description": "Effective hypotheses with a terminal state or an effective negative relation. This classification records contestation without granting the relation actor decision authority."},
        "open_theory_hypothesis_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "description": "Effective non-terminal hypotheses without an effective negative relation. These are open theories, not submission candidates."},
        "active_hypothesis_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "description": "Backward-compatible alias of open_theory_hypothesis_ids; never the submission-candidate pool."},
        "submission_candidate_pool": {"$ref": "#/$defs/submissionCandidatePool", "description": "The latest unambiguous gate report that explicitly declares candidate_count, evaluated_candidate_ids, and experiment_authorized."},
        "portfolio_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "prediction_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "posterior_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "mechanism_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "open_anomaly_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "open_questions": {"type": "array", "items": {"type": "object"}},
        "portfolio_frontiers": {"type": "array", "items": {"$ref": "#/$defs/portfolioFrontier"}},
        "next_experiments": {"type": "array", "items": {"$ref": "#/$defs/nextExperiment"}},
        "next_experiment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nextExperiment"}]},
        "frontier_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "claim_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "depth_level", "supporting_ids", "refuting_ids", "mechanism_ids", "quality_assessment_ids", "boundary_ids", "portfolio_ids", "next_experiments", "next_experiment", "gaps", "decision_ready"],
        "properties": {
          "claim_id": {"type": "string"},
          "depth_level": {"enum": ["descriptive", "causal", "transferable"]},
          "supporting_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "refuting_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "mechanism_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "quality_assessment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "boundary_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "portfolio_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "next_experiments": {"type": "array", "items": {"$ref": "#/$defs/nextExperiment"}},
          "next_experiment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nextExperiment"}]},
          "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "decision_ready": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "strategy_summary": {
      "type": "object",
      "required": ["profile", "layer_counts", "review_due", "latest_review_id", "open_anomaly_count", "claim_depth_counts"],
      "properties": {
        "profile": {"const": "xscientist.deep-research-strategy.v1"},
        "layer_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "review_due": {"type": "boolean"},
        "latest_review_id": {"type": ["string", "null"]},
        "open_anomaly_count": {"type": "integer", "minimum": 0},
        "historical_hypothesis_count": {"type": "integer", "minimum": 0},
        "contested_hypothesis_count": {"type": "integer", "minimum": 0},
        "open_theory_hypothesis_count": {"type": "integer", "minimum": 0},
        "submission_candidate_count": {"type": ["integer", "null"], "minimum": 0},
        "experiment_authorized": {"type": ["boolean", "null"]},
        "claim_depth_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "scientific_closure": {"type": "object"},
    "integrity": {"type": "object"},
    "generated_at": {"type": "string"},
    "graph_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "submissionCandidatePool": {
      "type": "object",
      "required": ["status", "source_gate_ids", "source_gate_id", "source_gate_state", "source_gate_actor_id", "source_gate_authority", "source_gate_authoritative", "candidate_count", "evaluated_candidate_ids", "experiment_authorized", "decision", "gate_status"],
      "properties": {
        "status": {"enum": ["unreported", "reported", "ambiguous"]},
        "source_gate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source_gate_id": {"type": ["string", "null"]},
        "source_gate_state": {"type": ["string", "null"]},
        "source_gate_actor_id": {"type": ["string", "null"]},
        "source_gate_authority": {"type": ["string", "null"]},
        "source_gate_authoritative": {"type": "boolean"},
        "candidate_count": {"type": ["integer", "null"], "minimum": 0},
        "evaluated_candidate_ids": {"type": "array", "items": {"type": "string"}},
        "experiment_authorized": {"type": ["boolean", "null"]},
        "decision": {"type": ["string", "null"]},
        "gate_status": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "nextExperiment": {
      "type": "object",
      "required": ["portfolio_id", "priority_object_id", "candidate_id", "design_object_id", "summary", "expected_information_gain", "utility_score"],
      "properties": {
        "portfolio_id": {"type": "string"},
        "priority_object_id": {"type": "string"},
        "candidate_id": {"type": "string"},
        "design_object_id": {"type": ["string", "null"]},
        "summary": {"type": "string"},
        "expected_information_gain": {"type": "number", "minimum": 0, "maximum": 1},
        "utility_score": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "portfolioFrontier": {
      "type": "object",
      "required": ["portfolio_id", "hypothesis_ids", "posterior_update_id", "next_experiment"],
      "properties": {
        "portfolio_id": {"type": "string"},
        "hypothesis_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "posterior_update_id": {"type": ["string", "null"]},
        "next_experiment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nextExperiment"}]}
      },
      "additionalProperties": false
    }
  }
}
